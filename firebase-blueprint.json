{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "analyst", "viewer"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "User OSINT investigation workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived", "review"] }
      },
      "required": ["id", "title", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles collection"
    },
    "/users/{userId}/investigations/{invId}": {
      "schema": { "$ref": "#/entities/Investigation" },
      "description": "Private user investigations"
    }
  }
}
